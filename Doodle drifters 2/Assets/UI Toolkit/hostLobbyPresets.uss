:root {
}

.playerName {
    position: absolute;
    font-size: 30px;
    -unity-text-align: middle-center;
    background-color: rgb(255, 255, 255);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    align-self: center;
    align-items: center;
    flex-wrap: nowrap;
    transform-origin: center;
    text-overflow: clip;
    bottom: auto;
    white-space: normal;
    right: auto;
    left: auto;
    top: 100%;
    width: auto;
    justify-content: flex-start;
    align-content: flex-start;
    max-width: 250px;
}

.playerAvatar {
    background-color: rgb(255, 255, 255);
    width: 200px;
    height: 200px;
    position: absolute;
    align-self: center;
    align-items: center;
    align-content: center;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    background-image: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=4584671053970592468&guid=0d9d778c7e1ffff458f347a7cf8152e8&type=3#console.infoicon@2x");
}

.playerContainer {
    position: absolute;
    width: 250px;
    height: 200px;
}

.numericInputField {
    position: absolute;
    font-size: 35px;
    -unity-text-align: middle-center;
    background-color: rgb(255, 255, 255);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}

.button {
    transition-duration: 0.25s;
}

.button:hover {
    scale: 1.25 1.25 1.25;
    transition-duration: 0.25s;
}

.button:active {
    scale: 1 1;
}
